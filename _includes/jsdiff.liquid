{% assign recent_posts = collections.posts.pages | sort: "published_date" | reverse %}

{% if recent_posts.size > 1 %}
  {% assign newest = recent_posts[0] %}
  {% assign previous = recent_posts[1] %}

  <div class="change-widget">
    <h3>Recent changes</h3>
    <div id="site-change-patch" class="patch"></div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/diff@5.1.0/dist/diff.min.js"></script>
  <link rel="stylesheet" href="../sass/jsdiff.css">

  <script>
    function escapeHtml(str) {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }
    
    function renderDiff(oldText, newText) {
      var diff = Diff.diffLines(oldText, newText);
      var html = "";
    
      diff.forEach(function(part) {
        var lines = part.value.split("\n");
    
        lines.forEach(function(line) {
          if (!line.trim()) return;
    
          if (part.added) {
            html += `<div class="diff-line added">+ ${escapeHtml(line)}</div>`;
          } else if (part.removed) {
            html += `<div class="diff-line removed">- ${escapeHtml(line)}</div>`;
          } else {
            html += `<div class="diff-line unchanged">  ${escapeHtml(line)}</div>`;
          }
        });
      });
    
      document.getElementById("site-change-patch").innerHTML = html;
    }
    
    document.addEventListener("DOMContentLoaded", function () {
      var previousText = `{{ previous.content | strip_html | strip_newlines | escape }}`;
      var newestText = `{{ newest.content | strip_html | strip_newlines | escape }}`;
    
      renderDiff(previousText, newestText);
    });
  </script>

{% else %}
  <p>No recent changes available to generate a patch.</p>
{% endif %}